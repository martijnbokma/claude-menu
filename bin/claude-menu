#!/usr/bin/env bash
# Interactive Claude Code environment switcher.
# Config: ~/.config/claude-menu.env (override with CLAUDE_MENU_CONFIG).

set -euo pipefail

_cm="${BASH_SOURCE[0]:-$0}"
while [[ -L "$_cm" ]]; do
    _d="$(cd "$(dirname "$_cm")" && pwd -P)"
    _cm="$(readlink "$_cm")"
    [[ $_cm != /* ]] && _cm="$_d/$_cm"
done
_ROOT="$(cd "$(dirname "$_cm")/.." && pwd -P)"
unset _cm _d
# shellcheck disable=SC1091
source "$_ROOT/lib/claude-menu-env.sh"
# shellcheck disable=SC1091
source "$_ROOT/lib/claude-menu-modes.sh"
unset _ROOT

claude_menu_apply_shell_env

clear

while true; do
    echo "Claude Configuration Menu"
    echo "=========================="
    echo ""
    echo "  First-time & credentials"
    echo "  -----------------------"
    echo "  1. Setup wizard (API key / Keychain / Claude Pro only)"
    echo ""
    echo "  Connection mode (pick one)"
    echo "  ----------------------------"
    echo "  2. Anthropic API (api.anthropic.com)"
    echo "  3. Z.ai API (GLM) — model preset…"
    echo "  4. Claude Pro (subscription — no API billing in shell)"
    echo ""
    echo "  Inspect & run"
    echo "  -------------"
    echo "  5. Status + connection test"
    echo "  6. Start Claude (current configuration)"
    echo "  7. Exit"
    echo ""
    read -r -p "Choose [1-7]: " choice

    case $choice in
        1)
            echo ""
            echo "🔧 Running setup (same as scripts/setup.sh)..."
            echo ""
            if bash "$CLAUDE_MENU_ROOT/scripts/setup.sh"; then
                claude_menu_source_user_config
                claude_menu_load_keychain
                # Do not call claude_menu_apply_shell_env here — setup may not have written generated.sh yet.
                echo ""
                echo "✅ Setup finished. Config reloaded for this menu session."
            else
                echo ""
                echo "⚠️  Setup exited with an error or was cancelled."
            fi
            echo ""
            read -r -p "Press Enter to continue..."
            ;;
        2)
            echo ""
            if ! claude_menu_require_api_token; then
                read -r -p "Press Enter to continue..."
                continue
            fi
            echo "🔄 Switching to Direct Anthropic API..."
            claude_menu_set_mode 1
            echo "✅ Direct Anthropic configuration updated!"
            echo "   Models: Default Anthropic models"
            claude_menu_print_persist_hint
            echo ""
            read -r -p "Press Enter to continue..."
            ;;
        3)
            echo ""
            if ! claude_menu_require_api_token; then
                read -r -p "Press Enter to continue..."
                continue
            fi
            echo "Z.ai — GLM model preset"
            echo "-----------------------"
            echo "  Maps to Claude Code slots: Haiku (fast) / Sonnet / Opus."
            echo "  1. Default — ${CLAUDE_MENU_ZAI_DEFAULT_HAIKU} / ${CLAUDE_MENU_ZAI_DEFAULT_SONNET} / ${CLAUDE_MENU_ZAI_DEFAULT_OPUS}"
            echo "  2. GLM-5 — ${CLAUDE_MENU_ZAI_PRESET_GLM5_HAIKU} / ${CLAUDE_MENU_ZAI_PRESET_GLM5_SONNET} / ${CLAUDE_MENU_ZAI_PRESET_GLM5_OPUS}"
            echo "  3. Back"
            echo ""
            read -r -p "Choose [1-3]: " zai_preset
            case $zai_preset in
                1)
                    echo ""
                    echo "🔄 Z.ai API + default GLM models..."
                    claude_menu_set_zai_model_preset default
                    echo "✅ Z.ai configuration updated (default GLM)."
                    claude_menu_print_persist_hint
                    echo ""
                    read -r -p "Press Enter to continue..."
                    ;;
                2)
                    echo ""
                    echo "🔄 Z.ai API + GLM-5 (Sonnet/Opus slots)..."
                    claude_menu_set_zai_model_preset glm5
                    echo "✅ Z.ai configuration updated (GLM-5 preset)."
                    claude_menu_print_persist_hint
                    echo ""
                    read -r -p "Press Enter to continue..."
                    ;;
                3 | "")
                    ;;
                *)
                    echo ""
                    echo "❌ Invalid choice — use 1, 2, or 3."
                    echo ""
                    read -r -p "Press Enter to continue..."
                    ;;
            esac
            ;;
        4)
            echo ""
            echo "🔄 Switching to Claude Pro Subscription..."
            claude_menu_set_mode 3
            echo "✅ Claude Pro configuration updated!"
            echo "   Billing: Claude Pro Subscription (No API Usage)"
            echo "   Models: Default Anthropic models"
            claude_menu_print_persist_hint
            echo ""
            read -r -p "Press Enter to continue..."
            ;;
        5)
            echo ""
            echo "Current configuration"
            echo "----------------------"
            echo "Menu mode: ${CLAUDE_MENU_MODE:-'(pick 2–4 to save)'}"
            echo "API URL: ${ANTHROPIC_BASE_URL:-'Not set (Claude Pro)'}"
            if [[ "${CLAUDE_MENU_MODE:-}" == "pro" ]]; then
                echo "Auth Token: (unset — Claude Pro subscription; key may stay on disk for modes 2–3)"
            else
                echo "Auth Token: ${ANTHROPIC_AUTH_TOKEN:+Set}"
            fi
            echo "Non-essential Traffic: ${CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC:-'Not set'}"
            echo "Timeout: ${API_TIMEOUT_MS:-'Not set'}"
            echo "Haiku Model: ${ANTHROPIC_DEFAULT_HAIKU_MODEL:-'Default'}"
            echo "Sonnet Model: ${ANTHROPIC_DEFAULT_SONNET_MODEL:-'Default'}"
            echo "Opus Model: ${ANTHROPIC_DEFAULT_OPUS_MODEL:-'Default'}"
            echo "Plugins: ${CLAUDE_ENABLED_PLUGINS:-'Not set'}"
            echo "Marketplaces: ${CLAUDE_EXTRA_KNOWN_MARKETPLACES:-'Not set'}"
            echo "Billing: ${ANTHROPIC_BASE_URL:+API Usage}${ANTHROPIC_BASE_URL:-Claude Pro Subscription}"
            echo "Persistent file: ${CLAUDE_MENU_GENERATED}"
            if [[ -f "${CLAUDE_MENU_GENERATED}" ]]; then
                echo "  (exists — applied in new shells if you source claude-menu-shell-env in ~/.zshrc)"
            else
                echo "  (not created yet — choose a connection mode 2–4 to save a default)"
            fi
            echo ""
            echo "Connection test"
            echo "---------------"
            echo "API URL: ${ANTHROPIC_BASE_URL:-'(none — Claude Pro)'}"
            if command -v curl &>/dev/null; then
                if [[ -n "${ANTHROPIC_BASE_URL:-}" ]]; then
                    if curl -s --connect-timeout 5 "${ANTHROPIC_BASE_URL}" >/dev/null 2>&1; then
                        echo "✅ Reachable (curl, 5s timeout)"
                    else
                        echo "❌ Not reachable (curl failed or timed out)"
                    fi
                else
                    echo "ℹ️  No API URL — Claude Pro mode (nothing to ping)"
                fi
            else
                echo "⚠️  curl not installed — skipped"
            fi
            echo ""
            read -r -p "Press Enter to continue..."
            ;;
        6)
            echo ""
            echo "🚀 Starting Claude with current configuration..."
            echo "Mode: ${ANTHROPIC_BASE_URL:+API Usage}${ANTHROPIC_BASE_URL:-Claude Pro Subscription}"
            echo "Press Ctrl+C to return to menu"
            echo ""
            sleep 2
            claude
            echo ""
            echo "📋 Returned to menu"
            read -r -p "Press Enter to continue..."
            ;;
        7)
            echo ""
            echo "👋 Exiting menu..."
            echo "🚀 Start claude with: claude"
            exit 0
            ;;
        *)
            echo ""
            echo "❌ Invalid option! Please choose 1-7."
            echo ""
            read -r -p "Press Enter to continue..."
            ;;
    esac

    clear
done
