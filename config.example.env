# Copy to ~/.config/claude-menu.env and chmod 600.
# Or run ./scripts/setup.sh or `bun run setup` for an interactive wizard (Pro-only, file, or macOS Keychain).
#
# --- Why you need this ---
# claude-menu options 2 (Anthropic API) and 3 (Z.ai) require a key in the environment.
# Claude Code: ANTHROPIC_AUTH_TOKEN (bearer) and/or ANTHROPIC_API_KEY (X-Api-Key). Either forces API usage;
# ANTHROPIC_API_KEY overrides subscription even if you are logged in with Pro (see Anthropic env docs).
# Put your key below OR use Keychain (Option A) — otherwise you will see "ANTHROPIC_AUTH_TOKEN is not set".
# Menu option 4 (Claude Pro) does not use a key in this file.
#
# Optional: custom path for the file the menu writes when you choose connection modes 2–4 (default ~/.config/claude-menu.generated.sh)
# export CLAUDE_MENU_GENERATED="$HOME/.config/claude-menu.generated.sh"
#
# Built-in API URLs and Z.A.I defaults are in the repo: lib/claude-menu-constants.sh (single source of truth).
#
# --- Option A (recommended on macOS): Keychain, no token in this file ---
# Run once from the repo: ./scripts/keychain-store-token.sh
# export CLAUDE_MENU_KEYCHAIN_SERVICE="claude-menu-anthropic"
#
# --- Option B: plain env (chmod 600, never commit) ---
# Required for menu options 1 (Anthropic API) and 2 (Z.A.I API):
# export ANTHROPIC_AUTH_TOKEN="your-token-here"

# Optional: Z.A.I plugin marketplace JSON (single line).
# Point "path" at your local zai-coding-plugins directory if you use GLM plugins.
# ZAI_CLAUDE_EXTRA_KNOWN_MARKETPLACES='{"zai-coding-plugins":{"source":{"source":"directory","path":"/absolute/path/to/zai-coding-plugins"}}}'

# Optional overrides when using Z.A.I (menu 3 — submenu sets presets; same env vars):
# ANTHROPIC_DEFAULT_HAIKU_MODEL="glm-4.5-air"
# ANTHROPIC_DEFAULT_SONNET_MODEL="glm-4.7"
# ANTHROPIC_DEFAULT_OPUS_MODEL="glm-4.7"
# Or set GLM-5: ANTHROPIC_DEFAULT_SONNET_MODEL="glm-5" ANTHROPIC_DEFAULT_OPUS_MODEL="glm-5" (menu 3 → GLM-5)
